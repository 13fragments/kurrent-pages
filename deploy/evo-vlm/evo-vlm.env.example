# Portable ROCm vLLM bundle root.
BUNDLE_DIR=$HOME/.local/share/evo-vlm/vllm-rocm/vllm-rocm.tmp

# Persistent Hugging Face cache.
HF_HOME=$HOME/.cache/huggingface

# Default benchmark/reference VLM. AWQ is a practical first target on the EVO.
VLLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct-AWQ
VLLM_SERVED_MODEL=qwen2.5-vl-3b-awq

# Bind to the Tailscale IP for tailnet-only access, or 0.0.0.0 for all host interfaces.
VLLM_HOST=0.0.0.0
VLLM_PORT=8080

# Conservative defaults for Strix Halo. Increase after a clean smoke test.
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_DTYPE=float16
VLLM_EXTRA_ARGS='--trust-remote-code --quantization awq --limit-mm-per-prompt {"image":1}'

# Optional for private/gated models.
# HUGGING_FACE_HUB_TOKEN=

# Optional ROCm escape hatch. Leave unset unless the local stack needs it.
# HSA_OVERRIDE_GFX_VERSION=11.5.1
